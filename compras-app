import React, { useState } from 'react';
import {
  View,
  Text,
  FlatList,
  TouchableOpacity,
  StyleSheet,
} from 'react-native';

export default function App() {
  const [carrinho, setCarrinho] = useState([]);

  const produtos = [
    { id: '1', nome: 'Notebook', preco: 3500 },
    { id: '2', nome: 'Mouse', preco: 80 },
    { id: '3', nome: 'Teclado', preco: 150 },
    { id: '4', nome: 'Monitor', preco: 900 },
  ];

  const adicionarAoCarrinho = (produto) => {
    setCarrinho([...carrinho, produto]);
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Compras App</Text>

      <FlatList
        data={produtos}
        keyExtractor={(item) => item.id}
        renderItem={({ item }) => (
          <View style={styles.card}>
            <View>
              <Text style={styles.nome}>{item.nome}</Text>
              <Text style={styles.preco}>R$ {item.preco}</Text>
            </View>

            <TouchableOpacity
              style={styles.botao}
              onPress={() => adicionarAoCarrinho(item)}
            >
              <Text style={styles.textoBotao}>Adicionar</Text>
            </TouchableOpacity>
          </View>
        )}
      />

      <View style={styles.carrinho}>
        <Text style={styles.carrinhoTexto}>
          Itens no carrinho: {carrinho.length}
        </Text>
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    padding: 20,
    backgroundColor: '#f5f5f5',
    marginTop: 40,
  },
  titulo: {
    fontSize: 28,
    fontWeight: 'bold',
    marginBottom: 20,
    textAlign: 'center',
  },
  card: {
    backgroundColor: '#fff',
    padding: 15,
    marginBottom: 10,
    borderRadius: 10,
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
  },
  nome: {
    fontSize: 18,
    fontWeight: '600',
  },
  preco: {
    color: '#555',
    marginTop: 5,
  },
  botao: {
    backgroundColor: '#2196F3',
    paddingHorizontal: 15,
    paddingVertical: 8,
    borderRadius: 5,
  },
  textoBotao: {
    color: '#fff',
    fontWeight: 'bold',
  },
  carrinho: {
    marginTop: 20,
    padding: 15,
    backgroundColor: '#e8f5e9',
    borderRadius: 10,
  },
  carrinhoTexto: {
    fontSize: 18,
    fontWeight: 'bold',
  },
});
